
<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StrideControl UI - Komplett Designgalleri (Lenovo M10 1920x1200)</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <style>
        @font-face {
            font-family: 'Concielian Classic Conden';
            src: local('Concielian Classic Conden'), local('Concielian-Classic-Conden');
        }

        :root {
            --bg: #000000;
            --surface: #141414;
            --surface-elevated: #1a1a1a;
            --border: #282828;
            --accent: #0a84ff;       /* Wahoo / Apple Blå: pause, stigning, hvile, nøytral */
            --danger: #ff453a;       /* Coral Rød: arbeid, drag, fart */
            --success: #30d158;      /* Grønn: fullført, ja, nedjogg, quick start */
            --text: #ffffff;
            --text-dim: #8e8e93;
            --phase-warmup: #0a84ff; /* Wahoo-stil: ren blå tone for oppvarming */
            --phase-work: #ff453a;
            --phase-recovery: #2563eb;
            --phase-cooldown: #30d158;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }

        body {
            background: #080808;
            color: var(--text);
            font-family: 'Barlow Condensed', sans-serif;
            padding: 40px 20px 180px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 90px;
        }

        .screen-title {
            font-size: 28px;
            font-weight: 700;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 2px;
            width: 100%;
            max-width: 1920px;
            border-bottom: 2px solid #222;
            padding-bottom: 12px;
            margin-bottom: -60px;
        }
        .screen-title span { color: var(--accent); }

        /* 1920x1200 (16:10) rammestørrelse for Lenovo M10 (224 PPI) */
        .tablet-screen {
            width: 1920px;
            height: 1200px;
            background: var(--bg);
            border: 2px solid #333;
            border-radius: 28px;
            position: relative;
            box-shadow: 0 20px 60px rgba(0,0,0,0.95);
            overflow: hidden;
        }

        /* ---------------------------------------------------- */
        /* FELLES KNAPPERAD (RAD 1 OG RAD 5)                    */
        /* ---------------------------------------------------- */
        .btn-row {
            display: flex;
            justify-content: space-between;
            height: 140px;
            gap: 15px;
            width: 100%;
        }
        .btn {
            flex: 1;
            background: var(--surface);
            border: 2px solid var(--border);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 72px;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
            color: #fff;
        }
        .btn-incline { border-bottom: 6px solid var(--accent); }
        .btn-speed { border-bottom: 6px solid var(--danger); }

        /* TELEMETRI */
        .tele-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            border-right: 2px solid var(--border);
        }
        .tele-col:last-child { border-right: none; }
        .tele-lbl {
            font-size: 28px;
            color: var(--text-dim);
            text-transform: uppercase;
            margin-bottom: 6px;
            line-height: 1;
            font-weight: 600;
        }
        .tele-val {
            font-size: 115px;
            font-weight: 800;
            line-height: 0.85;
            font-variant-numeric: tabular-nums;
            color: #ffffff !important;
        }

        /* ---------------------------------------------------- */
        /* TOPPLINJE (LÅST HORISONTAL RAD - 65px HØY)           */
        /* ---------------------------------------------------- */
        .util-bar {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            height: 65px;
        }
        .util-left { display: flex; align-items: center; gap: 24px; }
        .sys-clock {
            font-size: 48px;
            font-weight: 600;
            color: var(--text-dim);
            letter-spacing: 1px;
            font-variant-numeric: tabular-nums;
            padding-left: 5px;
        }
        .user-badge {
            background: var(--surface);
            color: #fff;
            padding: 10px 28px;
            border-radius: 14px;
            font-size: 38px;
            font-weight: 700;
            text-transform: uppercase;
            border: 2px solid var(--border);
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .util-right { display: flex; align-items: center; gap: 20px; }
        .mode-segmented {
            display: flex;
            background: var(--surface);
            border: 2px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
        }
        .mode-btn {
            background: transparent;
            border: none;
            color: var(--text-dim);
            padding: 10px 32px;
            font-size: 36px;
            font-weight: 700;
            font-family: inherit;
            text-transform: uppercase;
        }
        .mode-btn.active { background: #2a2a2a; color: #fff; }
        .btn-setup {
            background: var(--surface);
            border: 2px solid var(--border);
            color: var(--text-dim);
            padding: 10px 30px;
            border-radius: 14px;
            font-size: 36px;
            font-weight: 700;
            text-transform: uppercase;
        }

        /* TOAST-VARSEL (RUNDEOPPSUMMERING) */
        .toast-notification {
            position: absolute;
            top: 100px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--surface);
            border: 2px solid var(--border);
            border-bottom: 4px solid var(--success);
            border-radius: 18px;
            padding: 15px 40px;
            display: flex;
            align-items: center;
            gap: 18px;
            z-index: 50;
            box-shadow: 0 15px 40px rgba(0,0,0,0.9);
        }
        .toast-icon { color: var(--success); font-weight: 900; font-size: 32px; }
        .toast-text { font-size: 28px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #fff; }

        /* ---------------------------------------------------- */
        /* 1. MANUELL LAYOUT                                    */
        /* ---------------------------------------------------- */
        .screen-manual {
            padding: 40px;
            display: grid;
            grid-template-rows: 140px 1fr auto 1fr 140px;
            row-gap: 0;
        }
        .manual-util-bar {
            position: absolute;
            top: 200px;
            left: 40px;
            right: 40px;
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
        }
        .manual-util-bar.disabled {
            opacity: 0.20;
            pointer-events: none;
        }

        .zone-manual-time {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 100%;
            transform: translateY(-10px);
        }
        .hero-lbl-scaled {
            font-size: 38px;
            font-weight: 700;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 6px;
        }
        .hero-time-manual {
            font-size: 145px;
            font-weight: 800;
            line-height: 0.85;
            font-variant-numeric: tabular-nums;
            color: #fff;
        }

        .zone-telemetry-manual {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            width: 98%;
            margin: 0 auto;
        }
        .zone-telemetry-manual.flat-run {
            grid-template-columns: repeat(4, 1fr);
            width: 85%;
        }

        .zone-manual-presets {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 40px;
            width: 100%;
            height: 100%;
        }
        .btn-preset-card {
            width: 440px;
            height: 145px;
            background: var(--surface);
            border: 2px solid var(--border);
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .btn-preset-card span:first-child { font-size: 52px; font-weight: 800; }
        .btn-preset-card span:last-child { font-size: 38px; color: var(--text-dim); margin-top: 4px; font-weight: 600; }
        .btn-preset-card.rest { border-bottom: 6px solid var(--accent); }
        .btn-preset-card.work { border-bottom: 6px solid var(--danger); }

        /* ---------------------------------------------------- */
        /* INTERVALL FELLES STRUKTUR                            */
        /* ---------------------------------------------------- */
        .screen-interval-base {
            padding: 35px 45px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .interval-main-workspace {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            margin: auto 0;
        }

        .hero-time-interval {
            font-size: 180px;
            font-weight: 800;
            line-height: 0.85;
            font-variant-numeric: tabular-nums;
            letter-spacing: -2px;
            color: #fff;
        }

        .timeline-box-massive {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-top: 4px;
        }
        .timeline-header-clean {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            font-size: 28px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .timeline-track-massive {
            height: 260px;
            background: #111;
            border: 2px solid var(--border);
            border-radius: 18px;
            display: flex;
            align-items: flex-end;
            padding: 6px;
            gap: 6px;
            width: 100%;
        }
        .t-block-mass {
            height: 100%;
            position: relative;
            border-radius: 8px;
            overflow: hidden;
            background: #181818;
        }
        .t-fill-mass {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            border-radius: 8px 8px 0 0;
        }
        .t-block-mass.completed { opacity: 0.18; }
        .t-block-mass.active { box-shadow: inset 0 0 0 3px #fff; }
        .t-block-mass.active .t-progress-mass {
            position: absolute;
            top: 0; left: 0; bottom: 0;
            background: rgba(255, 255, 255, 0.45);
            border-right: 5px solid #fff;
        }

        .telemetry-interval-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            width: 100%;
            margin-top: 15px;
        }

        /* 150px DEDIKERT BUNNSONE */
        .interval-action-zone {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 35px;
            width: 100%;
            height: 150px;
        }
        .btn-act-action {
            height: 135px;
            font-size: 46px;
            font-weight: 800;
            font-family: inherit;
            border-radius: 20px;
            background: var(--surface);
            border: 2px solid var(--border);
            text-transform: uppercase;
            display: flex;
            justify-content: center;
            align-items: center;
            letter-spacing: 2px;
            color: #fff;
            flex: 1;
            max-width: 520px;
        }
        .btn-act-action.rest { border-bottom: 6px solid var(--accent); }
        .btn-act-action.work { border-bottom: 6px solid var(--danger); }
        .btn-act-action.rescue { border-bottom: 6px solid var(--accent); min-width: 420px; }

        .interval-choice-zone {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 30px;
            width: 100%;
            height: 150px;
        }
        .btn-int-huge {
            flex: 1;
            max-width: 480px;
            height: 135px;
            background: var(--surface);
            border: 2px solid var(--border);
            border-radius: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 15px;
            color: #fff;
        }
        .btn-int-huge.selected { border-bottom: 6px solid var(--accent); background: #191919; }
        .btn-int-huge .title { font-size: 46px; font-weight: 700; text-transform: uppercase; }

        /* BUNNDIALOGER UTEN OVERLEGG - REN NØYTRAL KANT RUNDT BOKSEN */
        .embedded-bottom-dialog {
            width: 100%;
            height: 145px;
            background: #141414;
            border: 2px solid var(--border);
            border-radius: 20px;
            padding: 15px 45px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        }
        .dialog-txt-wrap {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .dialog-main-title {
            font-size: 46px;
            font-weight: 800;
            color: #fff;
        }
        .dialog-btn-group {
            display: flex;
            gap: 50px;
        }
        .btn-dialog-act {
            height: 105px;
            padding: 0 55px;
            font-size: 36px;
            font-weight: 700;
            font-family: inherit;
            border-radius: 18px;
            cursor: pointer;
            border: 2px solid var(--border);
            background: #222;
            color: #fff;
            min-width: 250px;
        }
        .btn-dialog-act.yes { border-bottom: 6px solid var(--success); font-weight: 800; }
        .btn-dialog-act.no { border-bottom: 6px solid var(--border); }
        .btn-dialog-act.prim { border-bottom: 6px solid var(--danger); }
        .btn-dialog-act.sec { border-bottom: 6px solid var(--accent); }

        /* SYNKRONISERT SIRKEL / TIMER-RING FOR HVILE */
        .timer-ring-wrap {
            display: flex;
            align-items: center;
            gap: 30px;
        }
        .progress-ring {
            position: relative;
            width: 96px;
            height: 96px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .progress-ring svg {
            transform: rotate(-90deg);
            width: 96px;
            height: 96px;
        }
        .progress-ring circle {
            fill: transparent;
            stroke-width: 8;
        }
        .progress-ring .bg {
            stroke: #222;
        }
        .progress-ring .progress {
            stroke: var(--accent);
            stroke-linecap: round;
            stroke-dasharray: 251; /* 2 * PI * 40 */
            stroke-dashoffset: 80;  /* tømmes proporsjonalt med hvilen */
        }
        .progress-ring .time-text {
            position: absolute;
            font-size: 30px;
            font-weight: 800;
            color: #fff;
            font-variant-numeric: tabular-nums;
        }

        /* FULLSKJERM MODALER */
        .modal-backdrop-sim {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 100;
        }
        .dialog-card-massive {
            background: var(--surface);
            border: 2px solid var(--border);
            border-radius: 28px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.9);
            display: flex;
            flex-direction: column;
            width: 1680px;
        }

        /* SPORTSMASTER LOGO */
        .sportsmaster-logo-clean {
            font-family: 'Concielian Classic Conden', 'Barlow Condensed', sans-serif;
            font-size: 76px;
            font-weight: 900;
            font-style: italic;
            letter-spacing: 3px;
            color: #ffffff;
            text-transform: lowercase;
            line-height: 1;
        }

        /* STEPPER OG TOGGLE-KOMPONENTER */
        .stepper-box {
            display: flex;
            align-items: center;
            background: #111;
            border: 2px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            height: 85px;
        }
        .stepper-btn {
            width: 85px;
            height: 100%;
            background: #1f1f1f;
            border: none;
            color: #fff;
            font-size: 44px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .stepper-val {
            flex: 1;
            text-align: center;
            font-size: 42px;
            font-weight: 800;
            color: #fff;
            font-variant-numeric: tabular-nums;
            padding: 0 15px;
        }

        .toggle-btn-small {
            background: #222;
            border: 2px solid var(--border);
            border-radius: 12px;
            padding: 8px 24px;
            font-size: 24px;
            font-weight: 700;
            color: var(--text-dim);
            text-transform: uppercase;
        }
        .toggle-btn-small.active {
            background: #2a2a2a;
            border-color: var(--accent);
            color: #fff;
        }

        /* RULLBAR BLUETOOTH ENHETSLISTE */
        .bt-list-scroll {
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-height: 250px;
            overflow-y: auto;
            padding-right: 10px;
        }
        .bt-list-scroll::-webkit-scrollbar {
            width: 8px;
        }
        .bt-list-scroll::-webkit-scrollbar-track {
            background: #111;
            border-radius: 4px;
        }
        .bt-list-scroll::-webkit-scrollbar-thumb {
            background: #333;
            border-radius: 4px;
        }
        .bt-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #181818;
            border: 2px solid var(--border);
            border-radius: 16px;
            padding: 16px 26px;
            min-height: 80px;
        }
        .bt-item.connected {
            border-color: #383838;
            background: #1d1d1d;
        }
        .bt-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .bt-dot {
            width: 18px;
            height: 18px;
            border-radius: 50%;
        }
        .bt-dot.green { background: var(--success); box-shadow: 0 0 10px rgba(48, 209, 88, 0.4); }
        .bt-dot.dim { background: #444; }
        .bt-name {
            font-size: 34px;
            font-weight: 700;
        }
        .bt-sub {
            font-size: 22px;
            color: var(--text-dim);
        }
    </style>
</head>
<body>

