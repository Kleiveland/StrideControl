            border-radius: 8px;
            letter-spacing: 1px;
        }
        .seg-btn.active {
            background: #2a2a2a;
            color: #fff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.5);
            border: 1px solid #444;
        }
        .btn-setup-text {
            background: var(--surface);
            border: 2px solid #333;
            color: var(--text-dim);
            padding: 8px 20px;
            border-radius: 10px;
            font-size: 20px;
            font-weight: 700;
            text-transform: uppercase;
        }

