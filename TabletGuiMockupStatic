    <div class="tablet-screen screen-manual">
        <div class="btn-row">
            <div class="btn btn-incline">0</div>
            <div class="btn btn-incline">1</div>
            <div class="btn btn-incline">2</div>
            <div class="btn btn-incline">4</div>
            <div class="btn btn-incline">6</div>
            <div class="btn btn-incline">8</div>
            <div class="btn btn-incline">10</div>
            <div class="btn btn-incline">12</div>
        </div>

        <div class="manual-util-bar disabled">
            <div class="util-left">
                <div class="sys-clock">12:22</div>
                <div class="user-badge">KRISTIAN &#9662;</div>
            </div>
            <div class="util-right">
                <div class="mode-segmented">
                    <button class="mode-btn active">Manuell</button>
                    <button class="mode-btn">Intervall</button>
                </div>
                <div class="btn-setup">Oppsett</div>
            </div>
        </div>

        <div class="zone-manual-time">
            <div class="hero-lbl-scaled">TID</div>
            <div class="hero-time-manual">18:40</div>
        </div>

        <div class="zone-telemetry-manual flat-run">
            <div class="tele-col"><div class="tele-lbl">Stigning</div><div class="tele-val">0.0</div></div>
            <div class="tele-col"><div class="tele-lbl">Distanse</div><div class="tele-val">4.05</div></div>
            <div class="tele-col"><div class="tele-lbl">Puls</div><div class="tele-val">158</div></div>
            <div class="tele-col"><div class="tele-lbl">Fart</div><div class="tele-val">13.0</div></div>
        </div>

        <div class="zone-manual-presets">
            <div class="btn-preset-card rest">
                <span>HVILE</span><span>Fart: 6.0</span>
            </div>
            <div class="btn-preset-card work">
                <span>DRAG</span><span>Fart: 16.0</span>
            </div>
        </div>

