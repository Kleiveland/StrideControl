                        <div style="font-size: 24px; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Antall drag</div>
                        <div class="stepper-box">
                            <button class="stepper-btn">–</button>
                            <div class="stepper-val">20</div>
                            <button class="stepper-btn">+</button>
                        </div>
                    </div>
                </div>

                <!-- RAD 3: PROGRESSJONS-KONTROLL (STARTFART + ØKNING PR DRAG + BEREGNET SLUTTFART) -->
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 25px; background: #111; border: 2px solid var(--border); border-radius: 18px; padding: 18px 24px;">
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <div style="font-size: 24px; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Startfart (Drag 1)</div>
                        <div class="stepper-box">
                            <button class="stepper-btn">–</button>
                            <div class="stepper-val">16.0 <span style="font-size: 22px; color: var(--text-dim);">km/t</span></div>
                            <button class="stepper-btn">+</button>
                        </div>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <div style="font-size: 24px; color: var(--accent); text-transform: uppercase; font-weight: 700;">Økning pr. drag</div>
                        <div class="stepper-box" style="border-color: var(--accent);">
                            <button class="stepper-btn">–</button>
                            <div class="stepper-val" style="color: var(--accent);">+0.1 <span style="font-size: 22px; color: var(--accent);">km/t</span></div>
                            <button class="stepper-btn">+</button>
                        </div>
                    </div>
                    <div style="display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; border-left: 2px solid var(--border); padding-left: 20px;">
                        <div style="font-size: 22px; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Beregnet Sluttfart</div>
                        <div style="font-size: 54px; font-weight: 800; color: #fff; line-height: 1;">17.9 <span style="font-size: 26px; color: var(--text-dim);">km/t</span></div>
                        <div style="font-size: 18px; color: var(--text-dim); margin-top: 4px;">Drag 20 oppnår 17.9 km/t</div>
                    </div>
                </div>

                <!-- RAD 4: NEDJOGG -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <div style="font-size: 24px; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Nedjoggstid</div>
                        <div class="stepper-box">
                            <button class="stepper-btn">–</button>
                            <div class="stepper-val">5 <span style="font-size: 22px; color: var(--text-dim);">min</span></div>
                            <button class="stepper-btn">+</button>
                        </div>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 24px; color: var(--text-dim); text-transform: uppercase; font-weight: 700;">Nedjogg Tempo</span>
                            <div style="display: flex; gap: 8px;">
                                <button class="toggle-btn-small">Fast</button>
                                <button class="toggle-btn-small active">Fritt</button>
                            </div>
                        </div>
                        <div class="stepper-box">
                            <button class="stepper-btn" style="opacity: 0.3;">–</button>
                            <div class="stepper-val" style="color: var(--text-dim);">Fritt</div>
                            <button class="stepper-btn" style="opacity: 0.3;">+</button>
                        </div>
                    </div>
                </div>

                <!-- BUNN: LAGRE OG AVBRYT -->
                <div style="display: flex; gap: 20px; margin-top: 5px;">
                    <button class="btn-act-action" style="flex: 1; max-width: none; height: 90px; font-size: 32px; border-bottom: 6px solid var(--accent);">
                        Lagre økt
                    </button>
                    <button class="btn-act-action" style="flex: 1; max-width: none; height: 90px; font-size: 32px; border-bottom: 6px solid var(--border);">
                        Avbryt
                    </button>
                </div>
            </div>
        </div>
    </div>


    <!-- 12. JUSTER HURTIGTASTER -->
    <div class="screen-title">12. JUSTER HURTIGTASTER <span>(MED LAGRE ENDRINGER OG AVBRYT I BUNN)</span></div>
    <div class="tablet-screen screen-manual">
        <div class="modal-backdrop-sim">
            <div class="dialog-card-massive" style="width: 1600px; padding: 45px 60px; gap: 25px;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--border); padding-bottom: 15px;">
                    <div style="font-size: 42px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px;">Juster hurtigtaster</div>
                    <div style="font-size: 24px; color: var(--text-dim); text-transform: uppercase;">Trykk på et trinn for å endre verdi</div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <div style="font-size: 26px; font-weight: 700; color: var(--text-dim); text-transform: uppercase;">Stigningstrinn (%)</div>
                    <div class="btn-row" style="height: 100px;">
                        <div class="btn btn-incline" style="font-size: 48px;">0</div>
                        <div class="btn btn-incline" style="font-size: 48px;">1</div>
                        <div class="btn btn-incline" style="font-size: 48px;">2</div>
                        <div class="btn btn-incline" style="font-size: 48px;">4</div>
                        <div class="btn btn-incline" style="font-size: 48px;">6</div>
                        <div class="btn btn-incline" style="font-size: 48px;">8</div>
                        <div class="btn btn-incline" style="font-size: 48px;">10</div>
                        <div class="btn btn-incline" style="font-size: 48px;">12</div>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <div style="font-size: 26px; font-weight: 700; color: var(--text-dim); text-transform: uppercase;">Fartstrinn (km/t)</div>
                    <div class="btn-row" style="height: 100px;">
                        <div class="btn btn-speed" style="font-size: 48px;">4</div>
                        <div class="btn btn-speed" style="font-size: 48px;">6</div>
                        <div class="btn btn-speed" style="font-size: 48px;">8</div>
                        <div class="btn btn-speed" style="font-size: 48px;">10</div>
                        <div class="btn btn-speed" style="font-size: 48px;">12</div>
                        <div class="btn btn-speed" style="font-size: 48px;">14</div>
                        <div class="btn btn-speed" style="font-size: 48px;">16</div>
                        <div class="btn btn-speed" style="font-size: 48px;">18</div>
                    </div>
                </div>

                <div style="display: flex; gap: 20px; margin-top: 15px;">
                    <button class="btn-act-action" style="flex: 1; max-width: none; height: 95px; font-size: 32px; border-bottom: 6px solid var(--accent);">
                        Lagre endringer
                    </button>
                    <button class="btn-act-action" style="flex: 1; max-width: none; height: 95px; font-size: 32px; border-bottom: 6px solid var(--border);">
                        Avbryt
                    </button>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
