    <style>
        :root {
            --bg: #000;
            --surface: #111;
            --surface-elevated: #1a1a1a;
            --border: #222;
            --accent: #0a84ff;
            --danger: #ff453a;
            --warning: #ff9f0a;
            --text: #fff;
            --text-dim: #8e8e93;
            --phase-warmup: #ffcc00;
            --phase-work: #ff453a;
            --phase-recovery: #0a84ff;
            --phase-cooldown: #30d158;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }

        body {
            background: #080808;
            color: var(--text);
            font-family: 'Barlow Condensed', sans-serif;
            padding: 30px 20px 80px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 50px;
        }

        .screen-label {
            font-size: 26px;
            font-weight: 700;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 2px;
            width: 100%;
            max-width: 1200px;
            border-bottom: 2px solid #222;
            padding-bottom: 10px;
            margin-bottom: -30px;
        }
        .screen-label span { color: var(--accent); }

        /* Nettbrett-skjerm: faste dimensjoner for presis mockup */
        .tablet-frame {
            width: 1200px;
            height: 750px;
            background: var(--bg);
            border: 2px solid #333;
            border-radius: 20px;
            padding: 30px 40px;
            position: relative;
            box-shadow: 0 10px 40px rgba(0,0,0,0.8);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* KNAPPERADER (RAD 1 OG RAD 5) */
        .btn-row {
            display: flex;
            justify-content: space-between;
            height: 110px;
            gap: 12px;
            width: 100%;
        }
        .btn {
            flex: 1;
            background: var(--surface);
            border: 2px solid var(--border);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 60px;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }
        .btn-speed { border-bottom: 6px solid var(--danger); }
        .btn-incline { border-bottom: 6px solid var(--accent); }

        /* KONTROLLINJE UNDER STIGNINGSTASTENE */
        .util-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            height: 50px;
            margin-top: 6px;
            margin-bottom: 4px;
        }
        .util-left { display: flex; align-items: center; gap: 16px; }
        .sys-clock {
            font-size: 26px;
            font-weight: 600;
            color: var(--text-dim);
            letter-spacing: 1px;
            font-variant-numeric: tabular-nums;
        }
        .user-badge {
            background: var(--surface);
            color: #fff;
            padding: 8px 18px;
            border-radius: 10px;
            font-size: 20px;
            font-weight: 700;
            text-transform: uppercase;
            border: 2px solid #333;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .segmented-mode {
            display: flex;
            background: #111;
            border: 2px solid #333;
            border-radius: 12px;
            padding: 3px;
            gap: 4px;
        }
        .seg-btn {
            background: transparent;
            border: none;
            color: var(--text-dim);
            padding: 6px 28px;
