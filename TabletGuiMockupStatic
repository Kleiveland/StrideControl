        .banner-recovery { background: var(--phase-recovery); color: #fff; }

        .hero-time {
            font-size: 115px;
            font-weight: 800;
            line-height: 0.85;
            font-variant-numeric: tabular-nums;
        }

        /* ZWIFT-LIGNENDE TIDSLINJE (100% BREDDE) */
        .timeline-container {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .timeline-header {
            display: flex;
            justify-content: space-between;
            font-size: 19px;
            font-weight: 600;
            color: var(--text-dim);
            text-transform: uppercase;
        }
        .timeline-track {
            height: 52px;
            background: #111;
            border: 2px solid #222;
            border-radius: 10px;
            display: flex;
            align-items: flex-end;
            padding: 3px;
            gap: 3px;
            width: 100%;
        }
        .t-block {
            height: 100%;
            position: relative;
            border-radius: 4px;
            overflow: hidden;
            background: #181818;
        }
        .t-fill {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            border-radius: 4px 4px 0 0;
            opacity: 0.35;
        }
        .t-block.completed { opacity: 0.2; }
        .t-block.active { box-shadow: inset 0 0 0 2px #fff; }
        .t-block.active .t-fill { opacity: 1; }
        .t-block.active .t-progress {
            position: absolute;
            top: 0; left: 0; bottom: 0;
            background: rgba(255, 255, 255, 0.45);
            border-right: 3px solid #fff;
        }

        /* TELEMETRIRAD */
        .telemetry-row {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            width: 100%;
            margin-top: 4px;
        }
        .tele-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            border-right: 2px solid #222;
        }
        .tele-col:last-child { border-right: none; }
        .tele-lbl {
            font-size: 22px;
            color: var(--text-dim);
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 2px;
        }
        .tele-val {
            font-size: 90px;
            font-weight: 800;
            line-height: 0.85;
            font-variant-numeric: tabular-nums;
        }

        /* BUNNSONE (RAD 4) */
        .bottom-zone {
            width: 100%;
            height: 110px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .preset-buttons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 30px;
            width: 100%;
        }
        .btn-preset {
            width: 360px;
            height: 105px;
            background: var(--surface);
            border: 2px solid #222;
            border-radius: 18px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .btn-preset span:first-child { font-size: 40px; font-weight: 700; }
        .btn-preset span:last-child { font-size: 18px; color: var(--text-dim); margin-top: 2px; }

        .interval-choice-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 24px;
            width: 100%;
        }
        .btn-int-card {
            width: 360px;
            height: 105px;
            background: var(--surface);
            border: 2px solid #222;
            border-radius: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 10px;
        }
        .btn-int-card.selected { border-color: var(--warning); background: #1a1a1a; }
        .btn-int-card .title { font-size: 36px; font-weight: 700; text-transform: uppercase; }

        .focus-actions {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 24px;
            width: 100%;
        }
        .btn-act {
            height: 100px;
            padding: 0 50px;
            font-size: 30px;
            font-weight: 700;
            font-family: inherit;
            border-radius: 18px;
            background: var(--surface);
            border: 2px solid #333;
            color: #fff;
            text-transform: uppercase;
        }
        .btn-act.rescue { color: var(--warning); border-color: var(--warning); }
        .btn-act.to-rest { color: var(--warning); border-color: var(--warning); }
    </style>
</head>
